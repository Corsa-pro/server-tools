<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.material.symbols</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='document_layout_setting']" position="after">
                <setting
                    id="material_symbols_style_setting"
                    help="How Material Symbols icons look for this company"
                    company_dependent="1"
                >
                    <field name="material_symbols_style" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
